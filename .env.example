# Shared
NODE_ENV=development

# API
API_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/playa_ai_map
AUTH_TOKEN_SECRET=change-me
OTP_SALT=change-me
OTP_TTL_MINUTES=15
ALLOW_DEBUG_OTP=true
ADMIN_EMAILS=admin@example.com
CORS_ORIGIN=http://localhost:3000

# Burning Man API and dataset URLs
BURNING_MAN_API_KEY=
BURNING_MAN_API_BASE_URL=https://api.burningman.org
DATASET_TARGET_YEAR=2026
DATASET_MIN_FALLBACK_YEAR=2024
DATASET_2025_CAMP_OUTLINES_URL=https://bm-innovate.s3.amazonaws.com/2025/camp_outlines_2025.geojson
DATASET_2025_CAMP_NAMES_URL=https://bm-innovate.s3.amazonaws.com/2025/camp_names_2025.geojson
DATASET_2024_CAMP_ARCHIVE_URL=https://bm-innovate.s3.amazonaws.com/2024/JSON/archive_camp_listings_2024-09-11.json
DATASET_2024_ART_ARCHIVE_URL=https://bm-innovate.s3.amazonaws.com/2024/JSON/archive_art_2024-09-11.json
DATASET_2024_EVENT_ARCHIVE_URL=https://bm-innovate.s3.amazonaws.com/2024/JSON/archive_events_2024-09-11.json

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
